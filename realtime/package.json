{
  "name": "@incidentflow/realtime",
  "version": "1.0.0",
  "private": true,
  "description": "IncidentFlow realtime fan-out service (SSE + WebSocket) backed by Redis pub/sub",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ioredis": "^5.8.2",
    "jose": "^6.1.0",
    "pino": "^9.13.1",
    "prom-client": "^15.1.3",
    "ws": "^8.18.3",
    "zod": "^4.1.14"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.1",
    "ioredis-mock": "^8.12.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.2.4"
  }
}
