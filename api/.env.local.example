# ---------------------------------------------------------------------------
# Running the API directly on a workstation, with no Docker
# ---------------------------------------------------------------------------
#
# Copy to .env when you want `php artisan serve` without PostgreSQL, Redis or
# Docker installed. Everything is swapped for a file- or process-local driver:
#
#   database  -> SQLite file
#   cache     -> file
#   queue     -> sync (jobs run inline, so no worker process is needed)
#   realtime  -> disabled (the SPA falls back to refetching on an interval)
#
# The application is fully functional this way apart from live updates. Use
# docker-compose for the complete stack.
#
# Note: `queue=sync` means a notification failure surfaces as a request error
# rather than a retry. That is a development convenience, not the production
# behaviour — see docker-compose.yml.

APP_NAME=IncidentFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Relative to the api/ directory; create it with `touch database/database.sqlite`
DB_DATABASE=database/database.sqlite

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

REALTIME_ENABLED=false

JWT_PRIVATE_KEY_PATH=storage/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=storage/keys/jwt-public.pem
# Plain HTTP locally, so the cookie cannot carry the Secure flag or the browser
# will silently drop it and every refresh will fail.
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAMESITE=lax

MAIL_MAILER=log
MAIL_FROM_ADDRESS=incidents@incidentflow.local
MAIL_FROM_NAME="IncidentFlow"

# ---------------------------------------------------------------------------
# Optional: with a local Redis
# ---------------------------------------------------------------------------
#
# The defaults above need nothing installed. If you do have Redis running
# locally, uncomment these to get the real thing: a durable queue you can watch
# with `php artisan queue:work`, and live updates from the realtime service.
#
# On Windows there is no official Redis build; the maintained port at
# github.com/tporadowski/redis is a portable ZIP that needs no installer.
#
# Note: Horizon requires ext-pcntl and ext-posix, which Windows does not have.
# Use `php artisan queue:work` there; Horizon runs in the Docker stack.
#
# REDIS_CLIENT=predis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# REALTIME_ENABLED=true
# REALTIME_CHANNEL_PREFIX=incidentflow
