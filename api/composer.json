{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "incidentflow/api",
    "type": "project",
    "description": "IncidentFlow API — incident lifecycle, RBAC, audit trail and metrics.",
    "keywords": ["incident-management", "laravel", "api"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "firebase/php-jwt": "^6.11",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.30",
        "laravel/tinker": "^2.10.1",
        "predis/predis": "^2.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "lint": "pint --test",
        "fix": "pint",
        "test": "phpunit",
        "check": [
            "@lint",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.0",
            "ext-pcntl": "8.3.0",
            "ext-posix": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
