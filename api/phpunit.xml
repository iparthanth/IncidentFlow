<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>

        <!--
            bcrypt is slow on purpose. Four rounds is meaningless as a password
            defence and entirely appropriate for a suite that hashes hundreds of
            throwaway users; production reads its cost from config, not here.
        -->
        <env name="BCRYPT_ROUNDS" value="4"/>

        <!--
            In-memory SQLite: each test gets a pristine schema in milliseconds
            with no cleanup to forget. CI additionally runs the whole suite
            against real PostgreSQL 16 (see .github/workflows/ci.yml), because
            portable-looking schema builder calls can still behave differently
            on the engine that actually ships.
        -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>

        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>

        <!--
            Redis is not available in the unit environment, and the publisher is
            deliberately fail-soft, so leaving this on would only add a logged
            warning per event. Tests that care about publishing assert against a
            fake publisher instead.
        -->
        <env name="REALTIME_ENABLED" value="false"/>

        <!-- Dedicated test key pair, generated by tests/bootstrap-keys.php. -->
        <env name="JWT_PRIVATE_KEY_PATH" value="storage/keys/testing-private.pem"/>
        <env name="JWT_PUBLIC_KEY_PATH" value="storage/keys/testing-public.pem"/>
        <!--
            Secure is off because the test client speaks plain HTTP, but
            SameSite is pinned to the production posture so a change to that
            default breaks a test rather than shipping quietly.
        -->
        <env name="JWT_REFRESH_COOKIE_SECURE" value="false"/>
        <env name="JWT_REFRESH_COOKIE_SAMESITE" value="strict"/>

        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="PULSE_ENABLED" value="false"/>
    </php>
</phpunit>
