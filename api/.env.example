# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=IncidentFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_VERSION=dev

# Where the SPA is served from. Used to build links in notification emails.
APP_FRONTEND_URL=http://localhost:8080

APP_TIMEZONE=UTC
APP_LOCALE=en

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# `json` writes one structured object per line to stdout — the right choice in
# containers, where the runtime owns collection and rotation. Use `single` only
# when running the API directly on a workstation.
LOG_CHANNEL=stack
LOG_STACK=json
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
# Hostnames are localhost, not Compose service names. docker-compose.yml sets
# DB_HOST/REDIS_HOST/MAIL_HOST itself for every api-family service, so a service
# name here is redundant inside Docker and simply wrong everywhere else --
# on CI it resolves to nothing and the run dies on DNS.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=incidentflow
DB_USERNAME=incidentflow
# Change before any deployment reachable from anywhere but your own laptop.
DB_PASSWORD=change-me-in-production

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# predis is a pure-PHP client, so no extension needs compiling into the image.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_REALTIME_DB=0
REDIS_HORIZON_DB=3

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# ---------------------------------------------------------------------------
# Realtime fan-out
# ---------------------------------------------------------------------------
REALTIME_ENABLED=true
REALTIME_REDIS_CONNECTION=realtime
# MUST match REDIS_CHANNEL_PREFIX in the realtime service, or the publisher and
# the subscriber sit on different channels and nothing is ever delivered.
REALTIME_CHANNEL_PREFIX=incidentflow
REALTIME_PUBLIC_URL=/realtime

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Generate with: php artisan jwt:keys
# The realtime service receives the PUBLIC key only — it verifies tokens and
# must never be able to mint them.
#
# Relative on purpose. These are anchored to the application root, so the same
# value is correct inside the container (/var/www/html), on a CI runner, and on
# a developer's laptop. An absolute container path here makes
# `php artisan jwt:keys` outside Docker try to mkdir /var/www and fail.
#
# For a real deployment prefer injecting the PEM itself as JWT_PRIVATE_KEY /
# JWT_PUBLIC_KEY: a pair regenerated on each container start invalidates every
# token the realtime tier is currently verifying.
JWT_PRIVATE_KEY_PATH=storage/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=storage/keys/jwt-public.pem
JWT_ISSUER=incidentflow-api
JWT_AUDIENCE_API=incidentflow-api
JWT_AUDIENCE_REALTIME=incidentflow-realtime

# Access tokens are not revocable by construction, so the TTL is the blast
# radius of a leaked one. Fifteen minutes, plus a denylist for explicit logout.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_REALTIME_TTL=60
JWT_DENYLIST_ENABLED=true

# Set false ONLY for plain-HTTP local development. In production a refresh
# cookie without Secure is a credential handed to any network observer.
JWT_REFRESH_COOKIE_SECURE=true
JWT_REFRESH_COOKIE_SAMESITE=strict

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Development uses Mailpit (bundled in docker-compose); nothing leaves the host.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=incidents@incidentflow.local
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Horizon
# ---------------------------------------------------------------------------
HORIZON_PREFIX=horizon:

# ---------------------------------------------------------------------------
# Operational limits
# ---------------------------------------------------------------------------
INCIDENT_EXPORT_MAX_ROWS=50000
NOTIFICATION_STALE_AFTER_MINUTES=5
NOTIFICATION_RETENTION_DAYS=90
IDEMPOTENCY_RETENTION_HOURS=24
# Leave unset to keep audit logs forever, which is the default and the point.
# AUDIT_LOG_RETENTION_DAYS=
